{
	"name": "Member Access",
	"license-name": "GPL-2.0-or-later",
	"version": "0.1.0",
	"author": [
		"[https://Professional.Wiki/ Professional Wiki]"
	],
	"url": "https://professional.wiki/en/extension/member-access",
	"descriptionmsg": "memberaccess-description",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"MessagesDirs": {
		"MemberAccess": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"ProfessionalWiki\\MemberAccess\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"ProfessionalWiki\\MemberAccess\\Tests\\": "tests/phpunit/"
	},
	"HookHandlers": {
		"schema": {
			"class": "ProfessionalWiki\\MemberAccess\\EntryPoints\\SchemaChangesHandler"
		},
		"sso": {
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newSsoAuthorizationHandlerHookHandler"
		},
		"login": {
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newMemberLoginHookHandler"
		},
		"passwordReset": {
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newPasswordResetHookHandler"
		},
		"api": {
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newUserListApiHookHandler"
		},
		"specialPages": {
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newUserListSpecialPageHookHandler"
		},
		"loginForm": {
			"class": "ProfessionalWiki\\MemberAccess\\EntryPoints\\LoginFormHandler"
		}
	},
	"Hooks": {
		"LoadExtensionSchemaUpdates": "schema",
		"PluggableAuthUserAuthorization": "sso",
		"UserLoggedIn": "login",
		"SpecialPasswordResetOnSubmit": "passwordReset",
		"ApiCheckCanExecute": "api",
		"SpecialPageBeforeExecute": "specialPages",
		"AuthChangeFormFields": "loginForm",
		"BeforePageDisplay": "loginForm"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "MemberAccess/modules"
	},
	"ResourceModules": {
		"ext.memberAccess.loginForm": {
			"styles": [ "ext.memberAccess.loginForm.less" ]
		}
	},
	"callback": "ProfessionalWiki\\MemberAccess\\EntryPoints\\RegistrationHandler::onRegistration",
	"AuthManagerAutoConfig": {
		"primaryauth": {
			"MemberAccessPrimaryAuthenticationProvider": {
				"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newMemberAuthenticationProvider",
				"sort": 10
			}
		}
	},
	"RevokePermissions": {
		"reader": {
			"edit": true,
			"createpage": true,
			"createtalk": true,
			"applychangetags": true,
			"changetags": true,
			"minoredit": true,
			"upload": true,
			"reupload": true,
			"reupload-own": true,
			"upload_by_url": true,
			"move": true,
			"movefile": true,
			"move-subpages": true,
			"delete": true,
			"undelete": true,
			"protect": true,
			"createaccount": true,
			"sendemail": true,
			"viewmyprivateinfo": true,
			"editmyprivateinfo": true,
			"editmyoptions": true,
			"cs-comment": true,
			"abusefilter-view": true,
			"abusefilter-log": true
		}
	},
	"config": {
		"MemberAccessReaderGroup": {
			"value": "reader",
			"description": "Name of the user group that members are placed in."
		},
		"MemberAccessCodeLogin": {
			"value": "off",
			"description": "Whom the one-time code login route lets in: \"allowlisted\" for the addresses an allowlist entry matches, \"open\" for every address, or \"off\" to not offer the route at all."
		},
		"MemberAccessApplyAllowlistToSso": {
			"value": false,
			"description": "Whether single sign-on logins are held to the allowlist. Only true holds them; with anything else the extension neither refuses nor records them."
		},
		"MemberAccessCodeTtlSeconds": {
			"value": 600,
			"description": "How long an issued login code stays valid, in seconds."
		},
		"MemberAccessCodeAttemptLimit": {
			"value": 5,
			"description": "How many times an issued login code may be entered before it is burned."
		},
		"MemberAccessEmailBurstLimit": {
			"value": 3,
			"description": "Maximum login code requests per email address within 15 minutes."
		},
		"MemberAccessEmailDailyLimit": {
			"value": 10,
			"description": "Maximum login code requests per email address within 24 hours."
		},
		"MemberAccessIpBurstLimit": {
			"value": 10,
			"description": "Maximum login code requests per client IP within 15 minutes."
		},
		"MemberAccessIpDailyLimit": {
			"value": 50,
			"description": "Maximum login code requests per client IP within 24 hours."
		},
		"MemberAccessSenderAddress": {
			"value": null,
			"description": "Email address login codes are sent from. Falls back to $wgPasswordSender when null."
		},
		"MemberAccessSessionDurationSeconds": {
			"value": 2592000,
			"description": "How long a remembered login lasts, in seconds. Sets $wgExtendedLoginCookieExpiration while a route can log a member in, so it applies to everyone on the wiki, not only to members. Set to 0 to leave that setting alone."
		},
		"MemberAccessBlockedApiModules": {
			"value": [ "allusers", "users", "blocks" ],
			"description": "Names of action API query submodules the reader group may not use."
		},
		"MemberAccessBlockedSpecialPages": {
			"value": [ "Listusers", "Activeusers", "BlockList", "Redirect", "Userrights" ],
			"description": "Canonical names of special pages the reader group may not open."
		}
	},
	"RestRoutes": [
		{
			"path": "/member-access/v0/groups",
			"method": [ "GET" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newListGroupsApi"
		},
		{
			"path": "/member-access/v0/groups",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newCreateGroupApi"
		},
		{
			"path": "/member-access/v0/groups/{id}",
			"method": [ "PUT" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newRenameGroupApi"
		},
		{
			"path": "/member-access/v0/groups/{id}",
			"method": [ "DELETE" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newDeleteGroupApi"
		},
		{
			"path": "/member-access/v0/groups/{id}/entries",
			"method": [ "GET" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newListEntriesApi"
		},
		{
			"path": "/member-access/v0/groups/{id}/entries",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newAddEntriesApi"
		},
		{
			"path": "/member-access/v0/entries/{id}",
			"method": [ "DELETE" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newRemoveEntryApi"
		},
		{
			"path": "/member-access/v0/members",
			"method": [ "GET" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newListMembersApi"
		},
		{
			"path": "/member-access/v0/members/{userId}/deactivate",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newDeactivateMemberApi"
		},
		{
			"path": "/member-access/v0/members/{userId}/reactivate",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newReactivateMemberApi"
		},
		{
			"path": "/member-access/v0/members/{userId}",
			"method": [ "DELETE" ],
			"factory": "ProfessionalWiki\\MemberAccess\\MemberAccessExtension::newRemoveMemberApi"
		}
	],
	"AvailableRights": [
		"memberaccess-manage"
	],
	"GroupPermissions": {
		"sysop": {
			"memberaccess-manage": true
		},
		"bureaucrat": {
			"memberaccess-manage": true
		}
	}
}
